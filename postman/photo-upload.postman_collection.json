{
  "info": {
    "name": "Photo Upload — T5.2 Tests",
    "description": "Tests for POST /students/{id}/photo endpoint.\n\n## Setup\n1. Set `base_url` (e.g. http://localhost:8000/api)\n2. Set `email` / `password` for admin credentials\n3. Run **🔐 Login** → then **👤 Select First Student** → then photo tests\n4. Have a test image ready (e.g. C:\\test\\photo.jpg)\n\nNo manual `student_id` config needed — auto-fetched from API.",
    "schema": "https://schema.postman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api", "type": "string" },
    { "key": "email",    "value": "admin@pnc.edu.kh", "type": "string" },
    { "key": "password", "value": "Admin@123456", "type": "string" },
    { "key": "jwt_token", "value": "", "type": "string" },
    { "key": "student_id", "value": "", "type": "string" },
    { "key": "saved_photo_path", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 Login",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('Has access_token', () => pm.expect(json).to.have.property('access_token'));",
            "pm.collectionVariables.set('jwt_token', json.access_token);"
          ],
          "type": "text/javascript"
        }
      }],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/v1/auth/login", "host": ["{{base_url}}"], "path": ["v1", "auth", "login"] }
      }
    },
    {
      "name": "👤 Select First Student",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "const students = json.data?.data || json.data;",
            "pm.test('Has at least one student', () => pm.expect(students.length).to.be.at.least(1));",
            "const firstId = Array.isArray(students) ? students[0].id : students[0].id;",
            "pm.collectionVariables.set('student_id', firstId);",
            "console.log('student_id set to:', firstId);"
          ],
          "type": "text/javascript"
        }
      }],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": { "raw": "{{base_url}}/v1/students?per_page=1", "host": ["{{base_url}}"], "path": ["v1", "students"], "query": [{ "key": "per_page", "value": "1" }] }
      }
    },
    {
      "name": "📸 Photo Upload — Happy Path",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('Status is success', () => pm.expect(json.status).to.eql('success'));",
            "pm.test('Has photo_path', () => pm.expect(json.data.photo_path).to.not.be.empty);",
            "pm.test('Has photo_url', () => pm.expect(json.data.photo_url).to.include('/storage/students/photos/'));",
            "pm.collectionVariables.set('saved_photo_path', json.data.photo_path);"
          ],
          "type": "text/javascript"
        }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "photo",
              "type": "file",
              "src": "C:\\test\\photo.jpg",
              "description": "Update this path to a real JPG/PNG file on your machine"
            }
          ]
        },
        "url": { "raw": "{{base_url}}/v1/students/{{student_id}}/photo", "host": ["{{base_url}}"], "path": ["v1", "students", "{{student_id}}", "photo"] }
      }
    },
    {
      "name": "📸 Photo Upload — Invalid File Type (Rejected)",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 422', () => pm.response.to.have.status(422));",
            "const json = pm.response.json();",
            "pm.test('Error message mentions format', () => pm.expect(json.message.toLowerCase()).to.include('jpg') || pm.expect(json.message.toLowerCase()).to.include('file') || pm.expect(json.message.toLowerCase()).to.include('image'));"
          ],
          "type": "text/javascript"
        }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "photo",
              "type": "file",
              "src": "C:\\test\\test.txt",
              "description": "Point to a .txt or .pdf file to verify rejection"
            }
          ]
        },
        "url": { "raw": "{{base_url}}/v1/students/{{student_id}}/photo", "host": ["{{base_url}}"], "path": ["v1", "students", "{{student_id}}", "photo"] }
      }
    },
    {
      "name": "📸 Photo Upload — Student Not Found (404)",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 404', () => pm.response.to.have.status(404));",
            "const json = pm.response.json();",
            "pm.test('Error message says not found', () => pm.expect(json.message).to.include('not found'));"
          ],
          "type": "text/javascript"
        }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "photo",
              "type": "file",
              "src": "C:\\test\\photo.jpg"
            }
          ]
        },
        "url": { "raw": "{{base_url}}/v1/students/999999/photo", "host": ["{{base_url}}"], "path": ["v1", "students", "999999", "photo"] }
      }
    },
    {
      "name": "📸 Verify — Student Detail Shows photo_path",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('photo_path is present', () => pm.expect(json.data.photo_path).to.not.be.empty);",
            "pm.test('photo_path matches saved value', () => {",
            "    const saved = pm.collectionVariables.get('saved_photo_path');",
            "    if (saved) pm.expect(json.data.photo_path).to.eql(saved);",
            "});"
          ],
          "type": "text/javascript"
        }
      }],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": { "raw": "{{base_url}}/v1/students/{{student_id}}", "host": ["{{base_url}}"], "path": ["v1", "students", "{{student_id}}"] }
      }
    }
  ]
}
