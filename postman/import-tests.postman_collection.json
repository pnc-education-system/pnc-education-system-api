{
  "info": {
    "name": "Import Validation — Full Flow Tests",
    "description": "End-to-end tests for student import, following the system flow: Login → Upload → View Details → View Errors → Commit.\n\n## Setup\n1. Set `base_url` — use `http://localhost:8000/api` if running `php artisan serve`, or adjust to your server\n2. Set `email` and `password` to valid admin credentials\n3. Run **🔐 Setup — Login** first to auto-save the JWT token\n4. Update file `src` paths to match your machine's absolute paths\n5. Generate test files: `php artisan import:generate-test-files`",
    "schema": "https://schema.postman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "email",
      "value": "admin@pnc.edu.kh",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Admin@123456",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "import_log_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Setup — Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "const json = pm.response.json();",
              "pm.test('Has access_token', () => {",
              "    pm.expect(json).to.have.property('access_token');",
              "});",
              "",
              "pm.collectionVariables.set('jwt_token', json.access_token);",
              "console.log('JWT token saved!');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/v1/auth/login",
          "host": ["{{base_url}}"],
          "path": ["v1", "auth", "login"]
        }
      }
    },
    {
      "name": "✅ Test 1 — Valid Upload (Happy Path)",
      "item": [
        {
          "name": "Step 1 — Upload File",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Response is success', () => {",
                  "    pm.expect(json.status).to.eql('success');",
                  "});",
                  "",
                  "pm.test('All 5 rows passed and none invalid', () => {",
                  "    pm.expect(json.data.total_rows).to.eql(5);",
                  "    pm.expect(json.data.valid_rows).to.eql(5);",
                  "    pm.expect(json.data.invalid_rows).to.eql(0);",
                  "});",
                  "",
                  "pm.test('Has import_log_id', () => {",
                  "    pm.expect(json.data.import_log_id).to.be.a('number');",
                  "});",
                  "",
                  "pm.collectionVariables.set('import_log_id', String(json.data.import_log_id));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "C:\\Users\\USER\\Desktop\\VC2\\pnc-education-system-api\\storage\\app\\testing\\imports\\valid_upload.xlsx"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/imports",
              "host": ["{{base_url}}"],
              "path": ["v1", "imports"]
            }
          }
        },
        {
          "name": "Step 2 — View Import Log",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Import log matches', () => {",
                  "    pm.expect(json.data.file_name).to.eql('valid_upload.xlsx');",
                  "    pm.expect(json.data.total_rows).to.eql(5);",
                  "    pm.expect(json.data.error_count).to.eql(0);",
                  "});",
                  "",
                  "pm.test('Has no errors', () => {",
                  "    pm.expect(json.data.errors.length).to.eql(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/imports/{{import_log_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "imports", "{{import_log_id}}"]
            }
          }
        },
        {
          "name": "Step 3 — View Errors (should be empty)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Zero errors for valid file', () => {",
                  "    pm.expect(json.data.total_errors).to.eql(0);",
                  "    pm.expect(json.data.errors.length).to.eql(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/imports/{{import_log_id}}/errors",
              "host": ["{{base_url}}"],
              "path": ["v1", "imports", "{{import_log_id}}", "errors"]
            }
          }
        },
        {
          "name": "Step 4 — Commit Import",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Commit succeeded', () => {",
                  "    pm.expect(json.status).to.eql('success');",
                  "    pm.expect(json.data.imported).to.eql(5);",
                  "    pm.expect(json.data.failed).to.eql(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"rows\": [\n        {\"student_id_no\":\"ST0001\",\"full_name\":\"John Doe\",\"gender\":\"Male\",\"dob\":\"2000-01-15\",\"phone\":\"0123456789\",\"email\":\"john@test.com\",\"province\":\"Phnom Penh\",\"high_school\":\"HS A\",\"selection_batch_id\":1,\"enrollment_status\":\"Pending\",\"intake_year\":2024},\n        {\"student_id_no\":\"ST0002\",\"full_name\":\"Jane Smith\",\"gender\":\"Female\",\"dob\":\"2001-05-20\",\"phone\":\"0987654321\",\"email\":\"jane@test.com\",\"province\":\"Battambang\",\"high_school\":\"HS B\",\"selection_batch_id\":1,\"enrollment_status\":\"Enrolled\",\"intake_year\":2024},\n        {\"student_id_no\":\"ST0003\",\"full_name\":\"Sokha Chea\",\"gender\":\"Male\",\"dob\":\"1999-11-02\",\"province\":\"Kandal\",\"high_school\":\"HS C\",\"selection_batch_id\":1,\"enrollment_status\":\"Pending\",\"intake_year\":2024},\n        {\"student_id_no\":\"ST0004\",\"full_name\":\"Srey Mom\",\"gender\":\"Female\",\"dob\":\"2002-03-18\",\"phone\":\"0112233445\",\"email\":\"srey@test.com\",\"province\":\"Siem Reap\",\"high_school\":\"HS D\",\"selection_batch_id\":2,\"enrollment_status\":\"Pending\",\"intake_year\":2024},\n        {\"student_id_no\":\"ST0005\",\"full_name\":\"Vannak Phorn\",\"gender\":\"Male\",\"dob\":\"2000-07-30\",\"email\":\"vannak@test.com\",\"province\":\"Takeo\",\"high_school\":\"HS E\",\"selection_batch_id\":2,\"enrollment_status\":\"Enrolled\",\"intake_year\":2024}\n    ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/imports/{{import_log_id}}/commit",
              "host": ["{{base_url}}"],
              "path": ["v1", "imports", "{{import_log_id}}", "commit"]
            }
          }
        },
        {
          "name": "Step 5 — Verify Import Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Import completed successfully', () => {",
                  "    pm.expect(json.data.status).to.eql('Completed');",
                  "    pm.expect(json.data.success_count).to.eql(5);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/imports/{{import_log_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "imports", "{{import_log_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "❌ Test 2 — Extra Unknown Columns (Rejected)",
      "item": [
        {
          "name": "Step 1 — Upload File (expect rejection)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 422 Unprocessable Entity', () => {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Error message about unrecognised columns', () => {",
                  "    pm.expect(json.message).to.include('column(s) that the system does not recognise');",
                  "    pm.expect(json.message).to.include('random column');",
                  "    pm.expect(json.message).to.include('another extra');",
                  "});",
                  "",
                  "pm.test('No import log was created', () => {",
                  "    pm.expect(json).to.not.have.property('data');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "C:\\Users\\USER\\Desktop\\VC2\\pnc-education-system-api\\storage\\app\\testing\\imports\\extra_columns.xlsx"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/imports",
              "host": ["{{base_url}}"],
              "path": ["v1", "imports"]
            }
          }
        }
      ]
    },
    {
      "name": "⚠️ Test 3 — Duplicate Student IDs (Best Row Kept)",
      "item": [
        {
          "name": "Step 1 — Upload File (duplicates detected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Response is success', () => {",
                  "    pm.expect(json.status).to.eql('success');",
                  "});",
                  "",
                  "pm.test('4 total rows, 3 valid, 1 duplicate removed', () => {",
                  "    pm.expect(json.data.total_rows).to.eql(4);",
                  "    pm.expect(json.data.valid_rows).to.eql(3);",
                  "    pm.expect(json.data.invalid_rows).to.eql(1);",
                  "});",
                  "",
                  "pm.test('Duplicate error mentions student_id_no', () => {",
                  "    const invalidRows = json.data.validation.invalidRows;",
                  "    const dupErrors = invalidRows.filter(r => r.errors.student_id_no);",
                  "    pm.expect(dupErrors.length).to.eql(1);",
                  "    const msg = dupErrors[0].errors.student_id_no[0].toLowerCase();",
                  "    pm.expect(msg).to.include('duplicate');",
                  "});",
                  "",
                  "pm.test('Kept the most complete row (John Doe with phone+email over Johnny Doe without)', () => {",
                  "    const validRows = json.data.validation.validRows;",
                  "    const kept = validRows.find(r => r.student_id_no === 'ST0001');",
                  "    pm.expect(kept).to.not.be.undefined;",
                  "    pm.expect(kept.full_name).to.eql('John Doe');",
                  "    pm.expect(kept.phone).to.eql('0123456789');",
                  "    pm.expect(kept.email).to.eql('john@test.com');",
                  "});",
                  "",
                  "pm.collectionVariables.set('import_log_id', String(json.data.import_log_id));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "C:\\Users\\USER\\Desktop\\VC2\\pnc-education-system-api\\storage\\app\\testing\\imports\\duplicate_students.xlsx"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/imports",
              "host": ["{{base_url}}"],
              "path": ["v1", "imports"]
            }
          }
        },
        {
          "name": "Step 2 — View Import Errors (duplicate detail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Has 1 error record for the duplicate', () => {",
                  "    pm.expect(json.data.total_errors).to.eql(1);",
                  "    pm.expect(json.data.errors.length).to.eql(1);",
                  "});",
                  "",
                  "pm.test('Error is about duplicate student_id_no', () => {",
                  "    const error = json.data.errors[0];",
                  "    pm.expect(error.field).to.eql('student_id_no');",
                  "    pm.expect(error.error_message.toLowerCase()).to.include('duplicate');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/imports/{{import_log_id}}/errors",
              "host": ["{{base_url}}"],
              "path": ["v1", "imports", "{{import_log_id}}", "errors"]
            }
          }
        },
        {
          "name": "Step 3 — Commit (only unique rows)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Imported 3 unique rows, 0 failed', () => {",
                  "    pm.expect(json.data.imported).to.eql(3);",
                  "    pm.expect(json.data.failed).to.eql(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"rows\": [\n        {\"student_id_no\":\"ST0001\",\"full_name\":\"John Doe\",\"gender\":\"Male\",\"dob\":\"2000-01-15\",\"phone\":\"0123456789\",\"email\":\"john@test.com\",\"province\":\"Phnom Penh\",\"high_school\":\"HS A\",\"selection_batch_id\":1,\"enrollment_status\":\"Pending\",\"intake_year\":2024},\n        {\"student_id_no\":\"ST0002\",\"full_name\":\"Jane Smith\",\"gender\":\"Female\",\"dob\":\"2001-05-20\",\"phone\":\"0987654321\",\"email\":\"jane@test.com\",\"province\":\"Battambang\",\"high_school\":\"HS B\",\"selection_batch_id\":1,\"enrollment_status\":\"Enrolled\",\"intake_year\":2024},\n        {\"student_id_no\":\"ST0003\",\"full_name\":\"Sokha Chea\",\"gender\":\"Male\",\"dob\":\"1999-11-02\",\"phone\":\"0112233445\",\"province\":\"Kandal\",\"high_school\":\"HS C\",\"selection_batch_id\":2,\"enrollment_status\":\"Pending\",\"intake_year\":2024}\n    ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/imports/{{import_log_id}}/commit",
              "host": ["{{base_url}}"],
              "path": ["v1", "imports", "{{import_log_id}}", "commit"]
            }
          }
        },
        {
          "name": "Step 4 — Verify Final Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Import completed with 3 success, 0 errors', () => {",
                  "    pm.expect(json.data.status).to.eql('Completed');",
                  "    pm.expect(json.data.success_count).to.eql(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/imports/{{import_log_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "imports", "{{import_log_id}}"]
            }
          }
        }
      ]
    }
  ]
}
