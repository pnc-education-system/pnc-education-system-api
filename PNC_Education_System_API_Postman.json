    {
      "name": "🎓 Students",
      "description": "Student CRUD and management endpoints",
      "item": [
        {
          "name": "List Students",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/students?status=Pending&batch=1&province=Phnom%20Penh&search=ST001&page=1&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["v1", "students"],
              "query": [
                {
                  "key": "status",
                  "value": "Pending",
                  "description": "Filter by enrollment status (Pending, Enrolled, Rejected, Graduated, Dropped)"
                },
                {
                  "key": "batch",
                  "value": "1",
                  "description": "Filter by selection batch ID"
                },
                {
                  "key": "province",
                  "value": "Phnom Penh",
                  "description": "Search by province (partial match)"
                },
                {
                  "key": "search",
                  "value": "ST001",
                  "description": "Search by student ID, name, phone, or email"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "per_page",
                  "value": "15",
                  "description": "Items per page (default: 15)"
                }
              ]
            },
            "description": "Get paginated list of students with filters.\n\n**Permission:** `students.view`\n**Filters:** status, batch, province, search\n**Pagination:** page, per_page"
          }
        },
        {
          "name": "Create Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"student_id_no\": \"STC2025001\",\n    \"full_name\": \"Sok San\",\n    \"gender\": \"Male\",\n    \"dob\": \"2005-06-15\",\n    \"phone\": \"012345678\",\n    \"email\": \"sok.san@example.com\",\n    \"province\": \"Phnom Penh\",\n    \"high_school\": \"Toul Kork High School\",\n    \"selection_batch_id\": 1,\n    \"enrollment_status\": \"Pending\",\n    \"intake_year\": 2025,\n    \"enrolled_at\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/students",
              "host": ["{{base_url}}"],
              "path": ["v1", "students"]
            },
            "description": "Create a new student record.\n\n**Permission:** `students.edit`\n**Validation:**\n- student_id_no: required, unique\n- full_name: required, max 255\n- gender: required, Male/Female\n- selection_batch_id: required, must exist\n- enrollment_status: required, one of: Pending, Enrolled, Rejected, Graduated, Dropped"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('student_id', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Student Detail (with linked data)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/students/1",
              "host": ["{{base_url}}"],
              "path": ["v1", "students", "1"]
            },
            "description": "Get student details with all linked data:\n- Selection batch info\n- Student records with attachments\n- Evaluations with answers and form details\n- Student cards\n- Enrollment status history\n\n**Permission:** `students.view`, `students.edit`, or `enrollment.manage`"
          }
        },
        {
          "name": "Update Student",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"student_id_no\": \"STC2025001\",\n    \"full_name\": \"Sok San Updated\",\n    \"gender\": \"Male\",\n    \"dob\": \"2005-06-15\",\n    \"phone\": \"098765432\",\n    \"email\": \"sok.san.updated@example.com\",\n    \"province\": \"Kampong Cham\",\n    \"high_school\": \"Kampong Cham High School\",\n    \"selection_batch_id\": 1,\n    \"enrollment_status\": \"Enrolled\",\n    \"intake_year\": 2025\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/students/1",
              "host": ["{{base_url}}"],
              "path": ["v1", "students", "1"]
            },
            "description": "Update student details. Also supports POST method.\n\n**Permission:** `students.edit`\n**Supports photo upload:** use `form-data` with key `photo` (jpg,jpeg,png,webp, max 4MB)"
          }
        },
        {
          "name": "Update Student Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"Enrolled\",\n    \"note\": \"Student confirmed enrollment for academic year 2025\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/students/1/status",
              "host": ["{{base_url}}"],
              "path": ["v1", "students", "1", "status"]
            },
            "description": "Transition student enrollment status.\n\n**Permission:** `enrollment.manage`\n**Valid transitions:**\n- Pending → Enrolled, Rejected, Dropped\n- Enrolled → Graduated, Dropped\n- Rejected → Pending\n- Graduated → (no further transitions)\n- Dropped → Pending"
          }
        },
        {
          "name": "Bulk Update Student Status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"student_ids\": [1, 2, 3],\n    \"status\": \"Enrolled\",\n    \"note\": \"Bulk enrollment for batch 2025\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/students/bulk-status",
              "host": ["{{base_url}}"],
              "path": ["v1", "students", "bulk-status"]
            },
            "description": "Bulk update enrollment status for multiple students.\n\n**Permission:** `students.edit`\n**Note:** This is a force transition (bypasses transition rules)."
          }
        },
        {
          "name": "Bulk Confirm Students",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"student_ids\": [1, 2, 3]\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/students/bulk-confirm",
              "host": ["{{base_url}}"],
              "path": ["v1", "students", "bulk-confirm"]
            },
            "description": "Confirm multiple students at once.\n\n**Permission:** `students.edit`\nSets `is_confirmed = true` for all given student IDs."
          }
        }
      ]
    },
    {
      "name": "📥 Imports",
      "description": "Student import via Excel files",
      "item": [
        {
          "name": "Upload Excel File",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Excel file (.xlsx) - max 10MB"
                },
                {
                  "key": "selection_batch_id",
                  "value": "1",
                  "type": "text",
                  "description": "Selection batch ID to associate with import"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/imports",
              "host": ["{{base_url}}"],
              "path": ["v1", "imports"]
            },
            "description": "Upload Excel file for student import.\n\n**Permission:** `students.import`\n**Validates:** file type (.xlsx), file size, and row data.\n**Returns:** import_log_id, validation summary with valid/invalid rows.\n\n**Steps after upload:**\n1. Review validation errors using `GET /imports/{id}/errors`\n2. Commit the import using `POST /imports/{id}/commit` with the rows from the upload response"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.import_log_id) {",
                  "    pm.collectionVariables.set('import_log_id', jsonData.data.import_log_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Import History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/imports?status=Pending&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["v1", "imports"],
              "query": [
                {
                  "key": "status",
                  "value": "Pending",
                  "description": "Filter by status: Pending, Processing, Completed, Failed"
                },
                {
                  "key": "per_page",
                  "value": "15",
                  "description": "Items per page"
                }
              ]
            },
            "description": "Get paginated list of all import operations.\n\n**Permission:** `students.import`"
          }
        },
        {
          "name": "Get Import Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
