{
  "info": {
    "name": "PNC API - Auto Test (One Click)",
    "description": "Fully automated collection. Just click 'Run Collection' in Postman - everything works end-to-end with auto-generated test data.\n\nNo manual steps needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api/v1" },
    { "key": "access_token", "value": "" },
    { "key": "staff_token", "value": "" },
    { "key": "user_id", "value": "1" },
    { "key": "role_id", "value": "" },
    { "key": "batch_id", "value": "" },
    { "key": "import_log_id", "value": "" },
    { "key": "sample_rows", "value": "[{\"student_id_no\":\"ST-AUTO-001\",\"full_name\":\"Auto Generated\",\"gender\":\"Male\",\"dob\":\"2000-01-01\",\"phone\":\"012345678\",\"email\":\"auto@test.com\",\"province\":\"PP\",\"high_school\":\"Auto HS\",\"selection_batch_id\":1,\"enrollment_status\":\"Pending\",\"intake_year\":2025},{\"student_id_no\":\"ST-AUTO-002\",\"full_name\":\"Auto Two\",\"gender\":\"Female\",\"dob\":\"2001-02-02\",\"phone\":\"098765432\",\"email\":\"auto2@test.com\",\"province\":\"SR\",\"high_school\":\"Auto HS2\",\"selection_batch_id\":1,\"enrollment_status\":\"Pending\",\"intake_year\":2025}]" }
  ],
  "item": [
    {
      "name": "1. 🔐 Authentication",
      "item": [
        {
          "name": "1a. Login as Admin",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var jsonData = pm.response.json();",
                "if (jsonData.access_token) {",
                "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                "    pm.collectionVariables.set('user_id', String(jsonData.user.id));",
                "    console.log('✓ Admin logged in');",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@pnc.edu.kh\",\n  \"password\": \"Admin@123456\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "1b. Get My Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "1c. Logout",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"] }
          }
        },
        {
          "name": "1d. Login Again (after logout)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var jsonData = pm.response.json();",
                "if (jsonData.access_token) {",
                "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                "    console.log('✓ Re-logged in');",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@pnc.edu.kh\",\n  \"password\": \"Admin@123456\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "1e. Invalid Login (expect 401)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"wrong@test.com\",\n  \"password\": \"badpass\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "2. 👥 User Management",
      "item": [
        {
          "name": "2a. List Users",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/users", "host": ["{{base_url}}"], "path": ["users"] }
          }
        },
        {
          "name": "2b. Show User (ID 1)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/users/1", "host": ["{{base_url}}"], "path": ["users", "1"] }
          }
        },
        {
          "name": "2c. Create New User",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var jsonData = pm.response.json();",
                "if (jsonData.data && jsonData.data.id) {",
                "    pm.collectionVariables.set('user_id', String(jsonData.data.id));",
                "    console.log('✓ Created user ID: ' + jsonData.data.id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Staff\",\n  \"email\": \"teststaff@pnc.edu.kh\",\n  \"password\": \"Staff@123456\",\n  \"role_id\": 1,\n  \"is_active\": true\n}" },
            "url": { "raw": "{{base_url}}/users", "host": ["{{base_url}}"], "path": ["users"] }
          }
        },
        {
          "name": "2d. Toggle User Active",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/users/{{user_id}}/toggle", "host": ["{{base_url}}"], "path": ["users", "{{user_id}}", "toggle"] }
          }
        },
        {
          "name": "2e. Update User",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Staff Name\"\n}" },
            "url": { "raw": "{{base_url}}/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["users", "{{user_id}}"] }
          }
        },
        {
          "name": "2f. Delete User",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["users", "{{user_id}}"] }
          }
        }
      ]
    },
    {
      "name": "3. 🎭 Roles & Permissions",
      "item": [
        {
          "name": "3a. List Roles",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/roles", "host": ["{{base_url}}"], "path": ["roles"] }
          }
        },
        {
          "name": "3b. List Permissions",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/permissions", "host": ["{{base_url}}"], "path": ["permissions"] }
          }
        },
        {
          "name": "3c. Create New Role",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var jsonData = pm.response.json();",
                "if (jsonData.data && jsonData.data.id) {",
                "    pm.collectionVariables.set('role_id', String(jsonData.data.id));",
                "    console.log('✓ Created role ID: ' + jsonData.data.id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Editor\",\n  \"slug\": \"editor\",\n  \"description\": \"Test role\"\n}" },
            "url": { "raw": "{{base_url}}/roles", "host": ["{{base_url}}"], "path": ["roles"] }
          }
        },
        {
          "name": "3d. Show Role",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/roles/{{role_id}}", "host": ["{{base_url}}"], "path": ["roles", "{{role_id}}"] }
          }
        },
        {
          "name": "3e. Update Role with Permissions",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Senior Editor\",\n  \"permissions\": [\"students.view\", \"students.edit\"]\n}" },
            "url": { "raw": "{{base_url}}/roles/{{role_id}}", "host": ["{{base_url}}"], "path": ["roles", "{{role_id}}"] }
          }
        },
        {
          "name": "3f. Delete Role",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/roles/{{role_id}}", "host": ["{{base_url}}"], "path": ["roles", "{{role_id}}"] }
          }
        }
      ]
    },
    {
      "name": "4. 📊 Dashboard",
      "item": [
        {
          "name": "4a. Enrollment Stats",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/dashboard/enrollment", "host": ["{{base_url}}"], "path": ["dashboard", "enrollment"] }
          }
        }
      ]
    },
    {
      "name": "5. 📥 Student Import",
      "item": [
        {
          "name": "5a. Preview (No File - expect 422)",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/imports/preview", "host": ["{{base_url}}"], "path": ["imports", "preview"] }
          }
        },
        {
          "name": "5b. Commit Import (auto-generated rows)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "body": { "mode": "raw", "raw": "{\n  \"file_name\": \"auto-test.xlsx\",\n  \"rows\": {{sample_rows}}\n}" },
            "url": { "raw": "{{base_url}}/imports/commit", "host": ["{{base_url}}"], "path": ["imports", "commit"] }
          }
        },
        {
          "name": "5c. Bulk Import (StudentImportController)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "body": { "mode": "raw", "raw": "{\n  \"file_name\": \"bulk.xlsx\",\n  \"rows\": [\n    {\"student_id_no\":\"ST-BULK-001\",\"full_name\":\"Bulk One\",\"gender\":\"Male\",\"dob\":\"2000-01-01\",\"selection_batch_id\":1,\"intake_year\":2025}\n  ]\n}" },
            "url": { "raw": "{{base_url}}/import", "host": ["{{base_url}}"], "path": ["import"] }
          }
        },
        {
          "name": "5d. Validate Rows",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "body": { "mode": "raw", "raw": "{\n  \"rows\": [\n    {\"student_id_no\":\"ST-VALID-001\",\"full_name\":\"Valid\",\"gender\":\"Male\",\"dob\":\"2000-01-01\",\"selection_batch_id\":1,\"enrollment_status\":\"Pending\",\"intake_year\":2025}\n  ]\n}" },
            "url": { "raw": "{{base_url}}/import/validate", "host": ["{{base_url}}"], "path": ["import", "validate"] }
          }
        },
        {
          "name": "5e. Import History (List)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/imports", "host": ["{{base_url}}"], "path": ["imports"] }
          }
        },
        {
          "name": "5f. Import History (Show by ID 1)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/imports/1", "host": ["{{base_url}}"], "path": ["imports", "1"] }
          }
        }
      ]
    },
    {
      "name": "6. 📋 Students & Batches",
      "item": [
        {
          "name": "6a. List Students",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/students", "host": ["{{base_url}}"], "path": ["students"] }
          }
        },
        {
          "name": "6b. List Batches",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/selection-batches", "host": ["{{base_url}}"], "path": ["selection-batches"] }
          }
        },
        {
          "name": "6c. Create Batch",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var jsonData = pm.response.json();",
                "if (jsonData.data && jsonData.data.id) {",
                "    pm.collectionVariables.set('batch_id', String(jsonData.data.id));",
                "    console.log('✓ Created batch ID: ' + jsonData.data.id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Auto Batch 2026\",\n  \"year\": 2026\n}" },
            "url": { "raw": "{{base_url}}/selection-batches", "host": ["{{base_url}}"], "path": ["selection-batches"] }
          }
        },
        {
          "name": "6d. Show Batch",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/selection-batches/{{batch_id}}", "host": ["{{base_url}}"], "path": ["selection-batches", "{{batch_id}}"] }
          }
        },
        {
          "name": "6e. Update Batch",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Auto Batch\"\n}" },
            "url": { "raw": "{{base_url}}/selection-batches/{{batch_id}}", "host": ["{{base_url}}"], "path": ["selection-batches", "{{batch_id}}"] }
          }
        },
        {
          "name": "6f. Delete Batch",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": { "raw": "{{base_url}}/selection-batches/{{batch_id}}", "host": ["{{base_url}}"], "path": ["selection-batches", "{{batch_id}}"] }
          }
        }
      ]
    },
    {
      "name": "7. 🔑 Password Reset",
      "item": [
        {
          "name": "7a. Request Reset",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@pnc.edu.kh\"\n}" },
            "url": { "raw": "{{base_url}}/auth/password/reset", "host": ["{{base_url}}"], "path": ["auth", "password", "reset"] }
          }
        },
        {
          "name": "7b. Confirm Reset (expect error - no real token)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@pnc.edu.kh\",\n  \"reset_token\": \"invalid-token\",\n  \"password\": \"NewPass@123\",\n  \"password_confirmation\": \"NewPass@123\"\n}" },
            "url": { "raw": "{{base_url}}/auth/password/reset/confirm", "host": ["{{base_url}}"], "path": ["auth", "password", "reset", "confirm"] }
          }
        }
      ]
    },
    {
      "name": "8. 🔒 Permission & Security Tests",
      "item": [
        {
          "name": "8a. No Token (expect 401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/users", "host": ["{{base_url}}"], "path": ["users"] }
          }
        },
        {
          "name": "8b. Invalid Token (expect 401)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer invalid.token.here"}],
            "url": { "raw": "{{base_url}}/users", "host": ["{{base_url}}"], "path": ["users"] }
          }
        }
      ]
    }
  ]
}
