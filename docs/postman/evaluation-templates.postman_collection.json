		{
			"name": "🔄 Full CRUD Lifecycle",
			"item": [
				{
					"name": "Full Lifecycle Test",
					"request": {
						"description": "Executes the complete CRUD lifecycle to verify the full workflow:\n1. Create template\n2. Create 2 categories\n3. Create questions in each category\n4. Verify the nested structure via GET\n5. Update a question\n6. Update a category\n7. Delete a question\n8. Delete a category\n9. Delete the template",
						"method": "POST",
						"header": [
