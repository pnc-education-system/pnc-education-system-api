{
	"info": {
		"_postman_id": "evaluation-templates-2026-07-26",
		"name": "PNC Education - Evaluation Templates API",
		"description": "Complete CRUD API for the Self-Evaluation module (EPIC E8).\n\n## Setup\n1. Set `base_url` collection variable to your API base URL (e.g. `http://localhost:8000`)\n2. Run **Login** request first to auto-set the `token` variable\n3. All subsequent requests use the token automatically via the `Authorization` header",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "template_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "category_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "question_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "🔐 Authentication",
			"item": [
				{
					"name": "Login (auto-set token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"}",
									""
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@pnc.edu.kh\",\n  \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "📋 Evaluation Templates",
			"item": [
				{
					"name": "1. List All Templates",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/evaluation-templates",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "evaluation-templates"]
						}
					},
					"response": [
						{
							"name": "Success - Empty List",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"status\": \"success\",\n  \"message\": \"Evaluation templates retrieved successfully\",\n  \"data\": []\n}"
						},
						{
							"name": "Success - With Data",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"status\": \"success\",\n  \"message\": \"Evaluation templates retrieved successfully\",\n  \"data\": [\n    {\n      \"id\": 1,\n      \"name\": \"Young Stars Self-Assessment\",\n      \"description\": \"Standard self-evaluation\",\n      \"is_active\": true,\n      \"categories\": [\n        {\n          \"id\": 1,\n          \"name\": \"Communication\",\n          \"sort_order\": 1,\n          \"questions\": [\n            {\n              \"id\": 1,\n              \"question\": \"I communicate clearly\",\n              \"max_score\": 5.0,\n              \"sort_order\": 1\n            }\n          ]\n        }\n      ],\n      \"created_at\": \"2026-07-26T04:25:49.000000Z\",\n      \"updated_at\": \"2026-07-26T04:25:49.000000Z\"\n    }\n  ]\n}"
						}
					]
				},
				{
					"name": "2. Create Template",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Young Stars Self-Assessment\",\n  \"description\": \"Standard self-evaluation based on the UK Young Stars model.\",\n  \"is_active\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/evaluation-templates",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "evaluation-templates"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set('template_id', jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "3. Get Template by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/evaluation-templates/{{template_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "evaluation-templates", "{{template_id}}"]
						}
					}
				},
				{
					"name": "4. Update Template",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Updated Assessment Name\",\n  \"description\": \"Updated description\",\n  \"is_active\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/evaluation-templates/{{template_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "evaluation-templates", "{{template_id}}"]
						}
					}
				},
				{
					"name": "5. Update Template - Clear Description",
					"request": {
						"description": "Send `description` as null to clear the field.",
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"description\": null\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/evaluation-templates/{{template_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "evaluation-templates", "{{template_id}}"]
						}
					}
				},
				{
					"name": "6. Delete Template",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/evaluation-templates/{{template_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "evaluation-templates", "{{template_id}}"]
						}
					}
				}
			]
		},
